# SQLite DB パス（デフォルト: data/price-monitor.db）
# PRICE_MONITOR_DB_PATH=data/price-monitor.db

# Slack 通知（npm run monitor:notify で使用）
SLACK_WEBHOOK_URL=

# LINE 通知（npm run monitor:notify で使用）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# スクレイパー設定
HEADLESS=true
SKIP_IP_CHECK=false
CONCURRENCY=3
DELAY_MIN=3000
DELAY_MAX=7000

# Chromium パス（デフォルトはPlaywrightインストール済みのもの）
# CHROMIUM_PATH=
