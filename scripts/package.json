{
  "name": "@mykenko/scripts",
  "version": "0.0.1",
  "private": true,
  "description": "Data import / seed scripts for MYKENKO",
  "scripts": {
    "import:symptoms": "tsx import-symptoms.ts",
    "import:symptoms:dry": "tsx import-symptoms.ts --dry-run",
    "import:ingredients": "tsx import-ingredients.ts",
