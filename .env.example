# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=mykenko
POSTGRES_PASSWORD=mykenko_secret
POSTGRES_DB=mykenko
DATABASE_URL=postgresql://mykenko:mykenko_secret@localhost:5432/mykenko

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Meilisearch ──────────────────────────────────────────────
MEILI_MASTER_KEY=change_me_in_production
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=change_me_in_production

# ─── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── Ollama ───────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── n8n ──────────────────────────────────────────────────────
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# ─── Next.js Media (mykenko.jp) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_URL=http://localhost:8000
